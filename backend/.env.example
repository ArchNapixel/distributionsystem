# Copy to .env. Local values come from `pnpm --filter @drh/backend exec supabase status`.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Local stack direct connection. Deployed API uses the Supavisor transaction pooler URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional: DB integration tests (`pnpm test:db`). Defaults to the local stack; non-local hosts are refused.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
